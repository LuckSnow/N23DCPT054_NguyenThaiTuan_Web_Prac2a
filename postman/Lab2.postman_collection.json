{
  "info": {
    "_postman_id": "lab2-microservices-collection-uuid",
    "name": "Lab2 Microservices",
    "description": "Collection kiểm thử đầy đủ toàn bộ hệ thống Lab 2a Microservices (Product Service, Order Service, Auth Service, API Gateway, JWT Authentication, Redis Cache)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "gateway_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Auth Service (Yêu cầu 1)",
      "item": [
        {
          "name": "POST /api/auth/register - Đăng ký tài khoản",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tuan@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"Nguyễn Thái Tuấn\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/auth/register",
              "host": ["{{gateway_url}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "POST /api/auth/login - Đăng nhập (Lấy JWT Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set('jwt_token', res.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tuan@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/auth/login",
              "host": ["{{gateway_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "GET /api/auth/me - Xem thông tin user hiện tại (Bearer Token)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/auth/me",
              "host": ["{{gateway_url}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Products Service",
      "item": [
        {
          "name": "GET /api/products - Phân trang & Cache Redis",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/products?page=1&limit=5",
              "host": ["{{gateway_url}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "POST /api/products - Tạo sản phẩm (Xóa cache)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Product\",\n  \"price\": 100,\n  \"stock\": 10,\n  \"description\": \"Sản phẩm test\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/products",
              "host": ["{{gateway_url}}"],
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "POST /api/products - Validation thất bại (422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"price\": -1\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/products",
              "host": ["{{gateway_url}}"],
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "GET /api/products/:id - Tìm kiếm không tồn tại (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/products/999",
              "host": ["{{gateway_url}}"],
              "path": ["api", "products", "999"]
            }
          }
        },
        {
          "name": "GET /api/products - Tìm kiếm và lọc theo giá",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/products?search=iphone&minPrice=20000000",
              "host": ["{{gateway_url}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "search", "value": "iphone" },
                { "key": "minPrice", "value": "20000000" }
              ]
            }
          }
        },
        {
          "name": "DELETE /api/products/:id - Xóa mềm (Soft Delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/products/1",
              "host": ["{{gateway_url}}"],
              "path": ["api", "products", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Orders Service (Yêu cầu 2: Cần JWT Token)",
      "item": [
        {
          "name": "POST /api/orders - Tạo đơn hàng (Có JWT Bearer Token)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 1,\n  \"customerName\": \"Nguyễn Thái Tuấn\",\n  \"customerEmail\": \"tuan@example.com\",\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"productName\": \"iPhone 15 Pro\",\n      \"price\": 27990000,\n      \"quantity\": 1\n    }\n  ],\n  \"shippingAddress\": {\n    \"street\": \"123 Đường ABC\",\n    \"city\": \"Hồ Chí Minh\",\n    \"district\": \"Quận 1\"\n  },\n  \"note\": \"Giao giờ hành chính\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/orders",
              "host": ["{{gateway_url}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "POST /api/orders - Thất bại khi chưa đăng nhập (401)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 1,\n  \"customerName\": \"Nguyễn Thái Tuấn\",\n  \"items\": []\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/orders",
              "host": ["{{gateway_url}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "GET /api/orders/customer/:customerId - Lấy đơn hàng theo khách hàng",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/orders/customer/1?page=1&limit=10",
              "host": ["{{gateway_url}}"],
              "path": ["api", "orders", "customer", "1"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "PUT /api/orders/:id/status - Cập nhật trạng thái đơn hàng",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"confirmed\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/orders/ORDER_ID/status",
              "host": ["{{gateway_url}}"],
              "path": ["api", "orders", "ORDER_ID", "status"]
            }
          }
        }
      ]
    }
  ]
}
