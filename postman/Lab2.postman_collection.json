{
  "info": {
    "_postman_id": "lab2-microservices-collection-uuid",
    "name": "Lab2 Microservices",
    "description": "Collection kiểm thử API cho Lab 2a Microservices (Product Service, Order Service, API Gateway)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "gateway_url",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Products",
      "item": [
        {
          "name": "GET /api/products - Phân trang",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products?page=1&limit=5",
              "host": ["{{base_url}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "POST /api/products - Tạo sản phẩm hợp lệ",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Product\",\n  \"price\": 100,\n  \"stock\": 10,\n  \"description\": \"Sản phẩm test\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/products",
              "host": ["{{base_url}}"],
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "POST /api/products - Validation thất bại (422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"price\": -1\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/products",
              "host": ["{{base_url}}"],
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "GET /api/products/:id - Tìm kiếm không tồn tại (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products/999",
              "host": ["{{base_url}}"],
              "path": ["api", "products", "999"]
            }
          }
        },
        {
          "name": "GET /api/products - Tìm kiếm và lọc theo giá",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products?search=iphone&minPrice=20000000",
              "host": ["{{base_url}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "search", "value": "iphone" },
                { "key": "minPrice", "value": "20000000" }
              ]
            }
          }
        },
        {
          "name": "DELETE /api/products/:id - Xóa mềm (Soft Delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products/1",
              "host": ["{{base_url}}"],
              "path": ["api", "products", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "POST /api/orders - Tạo đơn hàng",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 1,\n  \"customerName\": \"Nguyễn Thái Tuấn\",\n  \"customerEmail\": \"tuan@example.com\",\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"productName\": \"iPhone 15 Pro\",\n      \"price\": 27990000,\n      \"quantity\": 1\n    }\n  ],\n  \"shippingAddress\": {\n    \"street\": \"123 Đường ABC\",\n    \"city\": \"Hồ Chí Minh\",\n    \"district\": \"Quận 1\"\n  },\n  \"note\": \"Giao giờ hành chính\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/orders",
              "host": ["{{gateway_url}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "GET /api/orders/customer/:customerId - Lấy đơn hàng theo khách hàng",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/orders/customer/1?page=1&limit=10",
              "host": ["{{gateway_url}}"],
              "path": ["api", "orders", "customer", "1"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "PUT /api/orders/:id/status - Cập nhật trạng thái đơn hàng",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"confirmed\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/orders/ORDER_ID/status",
              "host": ["{{gateway_url}}"],
              "path": ["api", "orders", "ORDER_ID", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/auth/register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"Nguyen Thai Tuan\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/auth/register",
              "host": ["{{gateway_url}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "POST /api/auth/login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/auth/login",
              "host": ["{{gateway_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    }
  ]
}
