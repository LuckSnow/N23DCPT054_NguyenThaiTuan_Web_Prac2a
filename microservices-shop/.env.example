# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN MICROSERVICES
# ==========================================

# ─── 1. PRODUCT SERVICE (Port 3001) ───
PRODUCT_SERVICE_PORT=3001
PRODUCT_SERVICE_NAME=product-service
# PostgreSQL - Supabase Session Pooler (port 5432 hỗ trợ migration và DDL)
DATABASE_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"
# PostgreSQL - Supabase Transaction Pooler (port 6543 dùng cho production query)
DATABASE_URL_POOL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ─── 2. ORDER SERVICE (Port 3002) ───
ORDER_SERVICE_PORT=3002
ORDER_SERVICE_NAME=order-service
# MongoDB Atlas Connection URI
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/ordersDB?retryWrites=true&w=majority"
ORDER_PRODUCT_SERVICE_URL="http://localhost:3001"

# ─── 3. AUTH SERVICE (Port 3003) ───
AUTH_SERVICE_PORT=3003
AUTH_DATABASE_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?schema=auth_service"
JWT_SECRET="your-super-secret-random-string-at-least-32-chars"
REFRESH_SECRET="your-super-refresh-secret-string-at-least-32-chars"
JWT_EXPIRES_IN="1d"

# ─── 4. REDIS CACHE (Port 6379) ───
REDIS_HOST="localhost"
REDIS_PORT=6379

# ─── 5. API GATEWAY (Port 3000) ───
GATEWAY_PORT=3000
PRODUCT_SERVICE_URL="http://localhost:3001"
ORDER_SERVICE_URL="http://localhost:3002"
AUTH_SERVICE_URL="http://localhost:3003"
ALLOWED_ORIGINS="*"
